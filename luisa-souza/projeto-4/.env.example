# ============================================================
# Pipeline UDA — Variáveis de Ambiente
# Copie este arquivo para .env e preencha com suas chaves
# ============================================================

# ---- LLM APIs (ao menos uma é obrigatória) ----
# Google Gemini (recomendado — free tier generoso)
GEMINI_API_KEY=sua_chave_gemini_aqui

# OpenAI (fallback opcional)
OPENAI_API_KEY=sua_chave_openai_aqui

# ---- Configurações do Pipeline ----
# Diretório onde os PDFs serão armazenados
PDF_STORAGE_DIR=./data/pdfs

# Caminho do banco SQLite
DATABASE_URL=sqlite:///./data/catalog.db

# Horário do job diário (formato HH:MM, fuso BRT/America_Sao_Paulo)
SCHEDULER_HOUR=8
SCHEDULER_MINUTE=0

# Delay mínimo entre requests ao mesmo domínio (segundos)
RATE_LIMIT_DELAY=30

# Número máximo de páginas enviadas em full-scan
FULL_SCAN_MAX_PAGES=20

# ---- API ----
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true
